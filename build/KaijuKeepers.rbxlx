            <string name="Name">Sounds</string>
            <string name="Source"><![CDATA[--[[
	Sound ids used by effects. The defaults are sounds built into Roblox.
	Replace them with your own ids from the Creator Store
	(e.g. "rbxassetid://1234567890") to make the game sound better.
	Leave a value as "" to disable that sound.
]]

return {
	Pop = "rbxasset://sounds/electronicpingshort.wav",
	LevelUp = "rbxasset://sounds/electronicpingshort.wav",
	Coin = "rbxasset://sounds/electronicpingshort.wav",
	Whoosh = "rbxasset://sounds/swordlunge.wav",
